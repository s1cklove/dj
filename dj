# compress

usage_compress() {
  cat >&2 <<EOF
Re-encodes a video with a more efficient codec and a slower preset.
Good for recordings made with a fast encoder preset (OBS, Zoom, screen recordings),
which can usually be shrunk several times without visible loss.
Audio is copied as is if the container allows it.

Usage:
  $prog compress [options] VIDEO|FOLDER...

Options:
  --h265          H.265/HEVC, 10-bit (default) — good compression, plays almost everywhere
  --av1           AV1 (SVT-AV1), 10-bit — compresses better and faster, but old devices can't handle it
  --h264          H.264 — maximum compatibility, worse compression
  --crf N         quality: lower is better and a bigger file
                  (default: h265 24, av1 32, h264 21; ±6 ≈ size ×2)
  --preset P      encoding speed: h265/h264 — ultrafast…veryslow (default medium/slow),
                  av1 — 0…13, lower is slower and better (default 6)
  --height N      scale down to N lines (e.g. 720)
  --fps N         cap the frame rate (30 or even 15 is enough for lectures)
  --test [SEC]    encode only a fragment from the middle (default 60 s)
                  and estimate the final file size — handy for picking --crf
  -f, --format F  container: mp4, mkv, mov (default — same as the source, otherwise mp4)
  -o, --output P  output file (with a single input) or folder for outputs;
                  default — next to the video (video.compressed.mp4)
  -y, --overwrite overwrite existing outputs (otherwise they are skipped)

Folders are walked recursively (hidden files and folders are skipped).
With -o, the subfolder structure is mirrored in the output folder.
EOF
  exit 1
}

cmd_compress() {
  local codec=h265 crf='' preset='' height='' fps='' test_len='' fmt='' args=()

  while (( $# )); do
    case $1 in
      --h265)          codec=h265 ;;
      --av1)           codec=av1 ;;
      --h264)          codec=h264 ;;
      --crf)           crf=${2:?$1 requires a value}; shift ;;
      --preset)        preset=${2:?$1 requires a value}; shift ;;
      --height)        height=${2:?$1 requires a value}; shift ;;
      --fps)           fps=${2:?$1 requires a value}; shift ;;
      --test)
        test_len=60
        if [[ "${2:-}" =~ ^[0-9]+$ ]]; then test_len=$2; shift; fi ;;
      -f|--format)     fmt=${2:?$1 requires a value}; shift ;;
      -o|--output)     output=${2:?$1 requires a value}; shift ;;
      -y|--overwrite)  overwrite=1 ;;
      -h|--help)       usage_compress ;;
      --)              shift; args+=("$@"); break ;;
      -*)              die "Unknown option: $1" ;;
      *)               args+=("$1") ;;
    esac
    shift
  done
  (( ${#args[@]} )) || usage_compress
  [[ -z $fmt || $fmt =~ ^(mp4|mkv|mov)$ ]] || die "Unknown format: $fmt (supported: mp4, mkv, mov)"
  require ffmpeg ffprobe awk

  case "$codec" in
    h265) crf=${crf:-24}; preset=${preset:-medium} ;;
    av1)  crf=${crf:-32}; preset=${preset:-6} ;;
    h264) crf=${crf:-21}; preset=${preset:-slow} ;;
  esac

  local vf=()
  [[ -n "$height" ]] && vf+=("scale=-2:'min($height,ih)':flags=lanczos")
  [[ -n "$fps" ]] && vf+=("fps='min($fps,source_fps)'")
  local vfilter=()
  if (( ${#vf[@]} )); then
    vfilter=(-vf "$(IFS=,; echo "${vf[*]}")")
  fi

  collect_inputs "${args[@]}"
  printf 'Codec: %s, CRF %s, preset %s%s%s\n' "$codec" "$crf" "$preset" \
    "${height:+, up to ${height}p}" "${fps:+, up to $fps fps}" >&2
  run_batch compress_one
}

compress_one() {
  local in=$1 ext=${1##*.} out oext
  ext=${ext,,}
  [[ $ext =~ ^(mp4|m4v|mkv|mov)$ ]] || ext=mp4
  out=$(out_path "$in" ".compressed.${fmt:-$ext}")
  [[ -n $test_len ]] && out="${out%.*}.test.${out##*.}"
  oext=${out##*.}
  oext=${oext,,}

  local vcodec
  case "$codec" in
    h265)
      vcodec=(-c:v libx265 -preset "$preset" -crf "$crf"
              -pix_fmt yuv420p10le -x265-params log-level=error)
      # Without the hvc1 tag, HEVC in mp4/mov won't open in QuickTime/on iOS.
      [[ "$oext" != mkv ]] && vcodec+=(-tag:v hvc1)
      ;;
    av1)
      vcodec=(-c:v libsvtav1 -preset "$preset" -crf "$crf"
              -pix_fmt yuv420p10le -svtav1-params tune=0)
      ;;
    h264)
      vcodec=(-c:v libx264 -preset "$preset" -crf "$crf" -pix_fmt yuv420p)
      ;;
  esac

  # Audio: copy if the codec fits the container, otherwise AAC (Opus for webm).
  local acodec_in acodec
  acodec_in=$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_name -of csv=p=0 "$in")
  case "$oext:$acodec_in" in
    *:)                                     acodec=() ;;
    mkv:*)                                  acodec=(-c:a copy) ;;
    webm:opus|webm:vorbis)                  acodec=(-c:a copy) ;;
    webm:*)                                 acodec=(-c:a libopus -b:a 128k) ;;
    mov:aac|mov:mp3|mov:alac|mov:ac3|mov:eac3|mov:pcm_*)
                                            acodec=(-c:a copy) ;;
    mov:*)                                  acodec=(-c:a aac -b:a 160k) ;;
    *:aac|*:mp3|*:opus|*:ac3|*:eac3|*:alac|*:flac)
                                            acodec=(-c:a copy) ;;
    *)                                      acodec=(-c:a aac -b:a 160k) ;;
  esac

  # Subtitles and attachments (fonts) are kept only in mkv:
  # most subtitle formats don't fit into mp4/mov as is.
  local maps=(-map 0:v:0 -map 0:a?)
  [[ "$oext" == mkv ]] && maps+=(-map 0:s? -map 0:t? -c:s copy)

  local extra=()
  case "$oext" in
    mp4|m4v|mov) extra=(-movflags +faststart) ;;
  esac

  # Test fragments are always overwritten: they get re-run with different --crf.
  [[ -n $test_len ]] && overwrite=1
  begin_output "$out" "$in"

  local duration enc_dur seek=()
  duration=$(duration_of "$in")
  enc_dur=$duration
  if [[ -n "$test_len" ]]; then
    local start
    start=$(awk -v d="$duration" -v l="$test_len" 'BEGIN { s = d/2 - l/2; print (s < 0 ? 0 : s) }')
    seek=(-ss "$start" -t "$test_len")
    enc_dur=$(awk -v d="$duration" -v l="$test_len" 'BEGIN { print (l < d ? l : d) }')
    printf 'Test: %s s starting at %s\n' "$test_len" "$(fmt_time "${start%.*}")" >&2
  fi

  ffrun "$enc_dur" \
    "${seek[@]}" -i "$in" \
    "${maps[@]}" -map_metadata 0 -map_chapters 0 \
    "${vfilter[@]}" "${vcodec[@]}" "${acodec[@]}" "${extra[@]}" \
    "$part"
  finish_output "$out"

  local in_size out_size
  in_size=$(stat -c %s "$in")
  out_size=$(stat -c %s "$out")

  if [[ -n "$test_len" ]]; then
    # Estimate: the fragment's size stretched to the source's full duration.
    local real_len est
    real_len=$(duration_of "$out")
    est=$(awk -v s="$out_size" -v l="$real_len" -v d="$duration" 'BEGIN { printf "%d", s * d / l }')
    printf 'Source: %s, estimate: ~%s (%sx smaller)\n' \
      "$(fmt_size "$in_size")" "$(fmt_size "$est")" "$(ratio "$in_size" "$est")" >&2
    echo "Fragment for comparison: $out" >&2
  else
    printf 'Done: %s — %s → %s (%sx smaller)\n' "$out" \
      "$(fmt_size "$in_size")" "$(fmt_size "$out_size")" "$(ratio "$in_size" "$out_size")" >&2
  fi
}

