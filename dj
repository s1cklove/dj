#!/usr/bin/env bash
# dj — a set of video processing helpers on top of ffmpeg.
set -euo pipefail

prog=$(basename "$0")

# Video files picked up from folders.
VIDEO_EXT_RE='\.(mp4|m4v|mkv|mov|webm|avi|wmv|flv|mts|m2ts|ts)$'
# dj's own outputs — skipped when walking a folder.
OWN_OUTPUT_RE='\.(compressed|enhanced|denoised|test|part)\.[^./]+$'

# Options shared by commands.
inputs=()     # input files
output=       # -o: a file (with a single input) or a folder
overwrite=0   # -y: overwrite existing outputs

die() { echo "$*" >&2; exit 1; }

# Bytes → "1.2GB".
fmt_size() {
  local n=$(( $1 * 10 )) u=B x
  for x in KB MB GB TB; do
    (( n < 10240 )) && break
    n=$(( n / 1024 )); u=$x
  done
  printf '%d.%d%s' $(( n / 10 )) $(( n % 10 )) "$u"
}

# Seconds → "1:02:03".
fmt_time() { printf '%d:%02d:%02d' $(( $1 / 3600 )) $(( $1 % 3600 / 60 )) $(( $1 % 60 )); }

duration_of() { ffprobe -v error -show_entries format=duration -of csv=p=0 "$1"; }

ratio() { awk -v a="$1" -v b="$2" 'BEGIN { printf "%.1f", (b > 0 ? a / b : 0) }'; }

usage() {
  cat >&2 <<EOF
Usage: $prog <command> [arguments]

Commands:
  extract    extract the audio track (e.g. for Adobe Podcast)
  replace    replace the audio track in a video
  compress   re-encode a video with more efficient settings
  denoise    remove noise from speech right in the video (DPDFNet, runs locally)

A command can be shortened to any unambiguous prefix: $prog c = $prog compress.
Command help: $prog <command> --help
EOF
  exit 1
}

# ---------------------------------------------------------------------------
# Dependencies

# Folder containing dj itself (in a clone, dj-denoise.py and .venv live next to it).
self_dir=$(dirname "$(readlink -f "$0")")

# Checks that the given programs are on PATH and lists all missing ones at once.
require() {
  local missing=() c
  for c in "$@"; do
    command -v "$c" >/dev/null || missing+=("$c")
  done
  (( ${#missing[@]} )) || return 0
  echo "Missing: ${missing[*]}" >&2
  echo "Install them with your package manager, e.g.: sudo apt install ffmpeg gawk" >&2
  exit 1
}

# Finds how to run the denoiser and sets denoiser.
# Under Nix it is dj-denoise on PATH; in a clone it is dj-denoise.py run by
# the python from .venv next to dj (or the system python3 if dpdfnet is installed there).
denoiser=()
require_denoiser() {
  if command -v dj-denoise >/dev/null; then
    denoiser=(dj-denoise); return
  fi
  local py=python3
  [[ -x $self_dir/.venv/bin/python ]] && py=$self_dir/.venv/bin/python
  if [[ -f $self_dir/dj-denoise.py ]] && "$py" -c 'import dpdfnet.stream' 2>/dev/null; then
    denoiser=("$py" "$self_dir/dj-denoise.py"); return
  fi
  cat >&2 <<EOF
Missing: dpdfnet (Python package for noise removal)
Install it into a .venv next to dj:
  python3 -m venv $self_dir/.venv
  $self_dir/.venv/bin/pip install 'dpdfnet==0.6.*'
EOF
  exit 1
}

# ---------------------------------------------------------------------------
# Running ffmpeg with progress

# Draws a one-line progress bar from ffmpeg -progress output (reads stdin).
# $1 — expected output duration in seconds (empty/N/A — unknown).
show_progress() {
  local dur_ms start=$SECONDS cols k v t=0 size=0 speed=
  dur_ms=$(awk -v d="${1:-0}" 'BEGIN { printf "%d", d * 1000 }')
  cols=$(stty size <&2 2>/dev/null | cut -d' ' -f2) || true
  (( ${cols:-0} > 0 )) || cols=80
  # On Ctrl+C keep reading until ffmpeg exits by itself, otherwise it complains about a closed pipe.
  trap '' INT

  draw() {
    local el=$(( SECONDS - start )) line bar='' w
    if (( dur_ms > 0 )); then
      (( t > dur_ms )) && t=$dur_ms
      local eta=--:--:-- est=
      if (( t > 0 && el > 0 )); then
        eta=$(fmt_time $(( el * (dur_ms - t) / t )))
      fi
      # Size estimate: the encoder buffers frames at first, so wait for at least 5%.
      if (( t * 20 >= dur_ms && t >= 1000 )); then
        est="  ~$(fmt_size $(( size * (dur_ms / 1000) / (t / 1000) )))"
      fi
      # Fixed-width fields so the bar doesn't jump around.
      printf -v line ' %s / %s  %6s  ETA %s%-10s' \
        "$(fmt_time $(( t / 1000 )))" "$(fmt_time $(( dur_ms / 1000 )))" "$speed" "$eta" "$est"
      # The bar takes the remaining space, but no more than 40 characters.
      w=$(( cols - ${#line} - 7 ))
      (( w > 40 )) && w=40
      if (( w >= 10 )); then
        local fill=$(( w * t / dur_ms ))
        printf -v bar '%*s' "$fill" ''; bar=${bar// /█}
        local rest; printf -v rest '%*s' $(( w - fill )) ''; bar+=${rest// /░}
        bar=" $bar"
      fi
      printf -v line '%4d%%%s%s' $(( t * 100 / dur_ms )) "$bar" "$line"
    else
      printf -v line ' %s  %s  %s' "$(fmt_time $(( t / 1000 )))" "$speed" "$(fmt_size "$size")"
    fi
    printf '\r\033[K%s' "${line:0:cols-1}" >&2
  }

  while IFS='=' read -r k v; do
    case $k in
      out_time_us) [[ $v =~ ^[0-9]+$ ]] && t=$(( v / 1000 )) ;;
      total_size)  [[ $v =~ ^[0-9]+$ ]] && size=$v ;;
      speed)       speed=${v// /} ;;
      progress)    [[ $v == end ]] && (( dur_ms > 0 )) && t=$dur_ms
                   draw ;;
    esac
  done
  printf '\n' >&2
}

# Рисует N параллельных прогресс-баров из файлов ffmpeg -progress.
# Завершается, когда во всех файлах появится progress=end.
#   draw_parallel_progress N DURATION_MS... PROGRESS_FILE...
draw_parallel_progress() {
  local n=$1; shift
  local -a durs=("${@:1:$n}")
  local -a files=("${@:1+n}")

  local tty=0 cols=80
  if [[ -t 2 ]]; then
    tty=1
    cols=$(stty size <&2 2>/dev/null | cut -d' ' -f2) || true
    (( ${cols:-0} > 0 )) || cols=80
  fi

  local start=$SECONDS first=1 done_count
  local i line bar rest w fill el speed eta dur_ms f vals t_ms
  local loop=''

  while :; do
    done_count=0
    if (( tty && ! first )); then
      printf '\033[%dA' "$n" >&2
    fi
    first=0

    for (( i = 0; i < n; i++ )); do
      dur_ms=${durs[$i]}
      f=${files[$i]}

      # out_time_ms в ffmpeg — на самом деле микросекунды (историческая
      # особенность). Берём последнее значение из файла.
      t_ms=0
      if [[ -s $f ]]; then
        vals=$(awk -F= '
          /^out_time_ms=/ { t = $2 }
          /^progress=/    { p = $2 }
          END { print (t ~ /^[0-9]+$/ ? int(t / 1000) : 0), p }' "$f" 2>/dev/null) || vals='0 '
        [[ $vals =~ ^([0-9]+)([[:space:]]|$) ]] && t_ms=${BASH_REMATCH[1]}
        if [[ $vals == *' end' ]]; then
          t_ms=$dur_ms
          done_count=$(( done_count + 1 ))
        fi
      fi
      (( dur_ms > 0 && t_ms > dur_ms )) && t_ms=$dur_ms

      el=$(( SECONDS - start ))
      speed='--'
      (( el > 0 && t_ms > 0 )) && \
        speed=$(awk -v t="$t_ms" -v e="$(( el * 1000 ))" \
                     'BEGIN { printf "%.1fx", t / e }')

      eta='--:--:--'
      if (( dur_ms > 0 && t_ms >= dur_ms )); then
        eta='0:00:00'
      elif (( el > 0 && t_ms > 0 )); then
        eta=$(fmt_time $(( el * (dur_ms - t_ms) / t_ms )))
      fi

      printf -v line ' [%d/%d] %s / %s  %6s  ETA %s' \
        "$(( i + 1 ))" "$n" \
        "$(fmt_time $(( t_ms / 1000 )))" \
        "$(fmt_time $(( dur_ms / 1000 )))" \
        "$speed" "$eta"

      w=$(( cols - ${#line} - 3 ))
      (( w > 30 )) && w=30
      if (( w >= 10 && dur_ms > 0 )); then
        fill=$(( w * t_ms / dur_ms ))
        printf -v bar '%*s' "$fill" ''; bar=${bar// /█}
        printf -v rest '%*s' $(( w - fill )) ''; bar+=${rest// /░}
        line+=" $bar"
      fi

      (( tty )) && printf '\r\033[K%s\n' "${line:0:cols-1}" >&2
    done

    (( done_count == n )) && break
    sleep 0.5
  done
}
# Runs ffmpeg with a one-line progress bar instead of -stats (which wraps
# in a narrow terminal, producing line after line).
#   ffrun [--log FILE] DURATION ffmpeg-args...
# With --log, ffmpeg's info-level messages go to FILE (e.g. for astats).
ffrun() {
  local log='' fd=2 level=error
  if [[ $1 == --log ]]; then log=$2; shift 2; fi
  local dur=$1; shift
  if [[ -n $log ]]; then
    level=info
    exec {fd}>"$log"
  fi
  local args=(-hide_banner -nostdin -nostats -y -loglevel "$level")
  # SVT-AV1 prints its banner to stderr regardless of -loglevel.
  export SVT_LOG=${SVT_LOG:-1}
  if [[ -t 2 ]]; then
    ffmpeg "${args[@]}" -progress pipe:1 "$@" 2>&$fd | show_progress "$dur"
  else
    ffmpeg "${args[@]}" "$@" 2>&$fd
  fi
  if [[ -n $log ]]; then exec {fd}>&-; fi
}

# ---------------------------------------------------------------------------
# Batch processing

# Each input's path relative to the folder it came from (for files — the name).
# Outputs in the -o folder are laid out by it, mirroring the subfolder structure.
declare -A rel_of=()

# Expands arguments into a list of files (inputs): folders are walked recursively
# and all video files are taken from them (skipping hidden files and folders and
# outputs of previous dj runs).
collect_inputs() {
  inputs=()
  local p root f found
  for p in "$@"; do
    if [[ -d $p ]]; then
      root=${p%/}; [[ -z $root ]] && root=/
      found=0
      while IFS= read -r -d '' f; do
        [[ ${f,,} =~ $VIDEO_EXT_RE ]] || continue
        [[ $f =~ $OWN_OUTPUT_RE ]] && continue
        inputs+=("$f"); found=1
        rel_of[$f]=${f#"${root%/}"/}
      done < <(find "$root" -mindepth 1 -name '.*' -prune -o -type f -print0 | sort -z)
      (( found )) || echo "No video files in folder: $p" >&2
    elif [[ -f $p ]]; then
      inputs+=("$p")
      rel_of[$p]=$(basename "$p")
    else
      die "Not found: $p"
    fi
  done
  (( ${#inputs[@]} )) || die "Nothing to process"
}

# Output path for input $1: next to it or in the -o folder.
# $2 — name suffix replacing the extension (e.g. .compressed.mp4).
out_path() {
  local in=$1 tail=$2
  if [[ -z $output ]]; then
    echo "${in%.*}$tail"
  elif [[ -d $output || $output == */ || ${#inputs[@]} -gt 1 ]]; then
    local rel=${rel_of[$in]:-$(basename "$in")}
    echo "${output%/}/${rel%.*}$tail"
  else
    echo "$output"
  fi
}

# Prepares writing output $1 for input $2. If the output already exists,
# exits with code 10 (skip). Otherwise sets $part — a temporary file that is
# removed on error or interruption; finish_output moves it into place.
cleanup=()
begin_output() {
  local out=$1 in=$2
  [[ $out -ef $in ]] && die "Output is the same file as the input: $out"
  if [[ -e $out && $overwrite == 0 ]]; then
    echo "Already exists: $out — skipping (-y to overwrite)" >&2
    exit 10
  fi
  mkdir -p "$(dirname "$out")"
  part="${out%.*}.part.${out##*.}"
  cleanup+=("$part")
}
finish_output() { mv -f -- "$part" "$1"; }

# Applies function $1 to each file in inputs. Each file is processed in a
# subshell so that an error in one doesn't stop the rest
# (traps are reset in a subshell, so we set them again).
run_batch() {
  local fn=$1 n=${#inputs[@]} i=0 rc ok=0 skipped=0 in
  local failed=()
  for in in "${inputs[@]}"; do
    i=$(( i + 1 ))
    (( n > 1 )) && printf '\n[%d/%d] %s\n' "$i" "$n" "$in" >&2
    set +e
    (
      set -e
      trap 'rm -rf -- "${cleanup[@]}"' EXIT
      trap 'exit 130' INT
      "$fn" "$in"
    )
    rc=$?
    set -e
    case $rc in
      0)  ok=$(( ok + 1 )) ;;
      10) skipped=$(( skipped + 1 )) ;;
      *)  failed+=("$in") ;;
    esac
  done

  if (( n > 1 )); then
    printf '\nDone: %d of %d' "$ok" "$n" >&2
    (( skipped )) && printf ', skipped: %d' "$skipped" >&2
    printf '\n' >&2
  fi
  if (( ${#failed[@]} )); then
    printf 'Failed:\n' >&2
    printf '  %s\n' "${failed[@]}" >&2
    return 1
  fi
}

trap 'printf "\nInterrupted\n" >&2; exit 130' INT

# ---------------------------------------------------------------------------
# extract

usage_extract() {
  cat >&2 <<EOF
Extracts the audio track from a video for uploading to Adobe Podcast.
Stereo with identical channels (or with one empty channel) is downmixed to mono.

Usage:
  $prog extract [options] VIDEO|FOLDER...

Options:
  --mono          always downmix to mono (no analysis)
  --stereo        always keep as is (no analysis)
  -f, --format F  format: wav (default), flac, mp3, m4a
  -o, --output P  output file (with a single input) or folder for outputs;
                  default — next to the video (video.wav)
  -y, --overwrite overwrite existing outputs (otherwise they are skipped)

Folders are walked recursively (hidden files and folders are skipped).
With -o, the subfolder structure is mirrored in the output folder.
EOF
  exit 1
}

# Analyzes the stereo track of file $1 (duration $2) and sets channel_layout:
# left/right — the other channel is empty, mono — channels are identical, stereo — they differ.
channel_layout=
analyze_channels() {
  local in=$1 duration=$2
  # How much quieter (in dB) the L-R difference signal must be than the louder
  # channel for the channels to count as identical.
  local DUP_THRESHOLD_DB=30
  # How much quieter a channel must be to count as empty.
  local SILENT_THRESHOLD_DB=40

  echo "Analyzing channels..." >&2
  # One pass: RMS of each channel and RMS of the L-R difference.
  local log stats left right diff
  log=$(mktemp); cleanup+=("$log")
  ffrun --log "$log" "$duration" -i "$in" -filter_complex \
    "[0:a:0]asplit=2[a][b];
     [a]astats=measure_perchannel=RMS_level:measure_overall=none[x];
     [b]pan=mono|c0=0.5*c0-0.5*c1,astats=measure_perchannel=none:measure_overall=RMS_level[y]" \
    -map "[x]" -f null - -map "[y]" -f null -
  stats=$(grep 'RMS level dB' "$log")

  read -r left right diff < <(awk '
    /Parsed_astats_1/ { ch[++n] = $NF }
    /Parsed_astats_3/ { d = $NF }
    END { print ch[1], ch[2], d }' <<<"$stats")

  # Turn -inf (complete silence) into -200 so awk can compare.
  num() { [[ "$1" == *inf* ]] && echo -200 || echo "$1"; }
  left=$(num "$left"); right=$(num "$right"); diff=$(num "$diff")
  printf 'RMS: L=%.1f dB, R=%.1f dB, L-R=%.1f dB\n' "$left" "$right" "$diff" >&2

  channel_layout=$(awk -v l="$left" -v r="$right" -v d="$diff" \
                       -v dup="$DUP_THRESHOLD_DB" -v sil="$SILENT_THRESHOLD_DB" 'BEGIN {
    loud = (l > r) ? l : r
    if (r < l - sil)       print "left"
    else if (l < r - sil)  print "right"
    else if (d < loud - dup) print "mono"
    else                   print "stereo"
  }')
}

# ffmpeg filter downmixing stereo to mono according to analyze_channels ($1).
mono_filter() {
  case $1 in
    left)  echo "Right channel is empty → mono from left" >&2; echo "pan=mono|c0=c0" ;;
    right) echo "Left channel is empty → mono from right" >&2; echo "pan=mono|c0=c1" ;;
    mono)  echo "Channels are identical → mono" >&2;          echo "pan=mono|c0=0.5*c0+0.5*c1" ;;
    *)     echo "Channels differ → downmixing to mono" >&2;   echo "pan=mono|c0=0.5*c0+0.5*c1" ;;
  esac
}

cmd_extract() {
  local mode=auto fmt=wav args=()
  while (( $# )); do
    case $1 in
      --mono)          mode=mono ;;
      --stereo)        mode=stereo ;;
      -f|--format)     fmt=${2:?$1 requires a value}; shift ;;
      -o|--output)     output=${2:?$1 requires a value}; shift ;;
      -y|--overwrite)  overwrite=1 ;;
      -h|--help)       usage_extract ;;
      --)              shift; args+=("$@"); break ;;
      -*)              die "Unknown option: $1" ;;
      *)               args+=("$1") ;;
    esac
    shift
  done
  (( ${#args[@]} )) || usage_extract
  require ffmpeg ffprobe awk
  collect_inputs "${args[@]}"
  run_batch extract_one
}

extract_one() {
  local in=$1 out
  out=$(out_path "$in" ".$fmt")

  local audio_codec
  case "${out##*.}" in
    wav)  audio_codec=(-c:a pcm_s16le) ;;
    flac) audio_codec=(-c:a flac -sample_fmt s16) ;;
    mp3)  audio_codec=(-c:a libmp3lame -b:a 192k) ;;
    m4a)  audio_codec=(-c:a aac -b:a 192k) ;;
    *)    die "Unknown format: $out (supported: wav, flac, mp3, m4a)" ;;
  esac

  local channels
  channels=$(ffprobe -v error -select_streams a:0 -show_entries stream=channels -of csv=p=0 "$in")
  [[ -z "$channels" ]] && die "No audio track in file: $in"

  begin_output "$out" "$in"
  local duration
  duration=$(duration_of "$in")

  # Decide what to do with the channels: af is the audio filter for the output.
  local af=anull
  if [[ "$channels" == 2 && "$mode" != stereo ]]; then
    if [[ "$mode" == mono ]]; then
      af="pan=mono|c0=0.5*c0+0.5*c1"
    else
      analyze_channels "$in" "$duration"
      case "$channel_layout" in
        stereo) echo "Channels differ → keeping stereo" >&2 ;;
        *)      af=$(mono_filter "$channel_layout") ;;
      esac
    fi
  fi

  ffrun "$duration" -i "$in" \
    -map 0:a:0 -vn -sn -dn -map_metadata -1 \
    -af "$af" "${audio_codec[@]}" "$part"
  finish_output "$out"

  echo "Done: $out" >&2
}

# ---------------------------------------------------------------------------
# replace

usage_replace() {
  cat >&2 <<EOF
Replaces the audio track in a video with another one (e.g. processed in Adobe Podcast).
Video is copied without re-encoding, audio is encoded to AAC (Opus for .webm).

Usage:
  $prog replace [-y] video.mp4 audio.wav [output.mp4]

By default the output is written to video.enhanced.mp4.
  -y, --overwrite  overwrite the output if it already exists
EOF
  exit 1
}

cmd_replace() {
  local args=()
  while (( $# )); do
    case $1 in
      -y|--overwrite)  overwrite=1 ;;
      -h|--help)       usage_replace ;;
      --)              shift; args+=("$@"); break ;;
      -*)              die "Unknown option: $1" ;;
      *)               args+=("$1") ;;
    esac
    shift
  done
  [[ ${#args[@]} -lt 2 || ${#args[@]} -gt 3 ]] && usage_replace
  require ffmpeg ffprobe

  local audio=${args[1]}
  output=${args[2]:-}
  [[ -f ${args[0]} ]] || die "Not found: ${args[0]}"
  [[ -f $audio ]] || die "Not found: $audio"
  inputs=("${args[0]}")
  run_batch replace_one
}

replace_one() {
  local video=$1 out
  out=$(out_path "$video" ".enhanced.${video##*.}")
  begin_output "$out" "$video"
  mux_audio "$video" "$out" -i "$audio"
  finish_output "$out"

  echo "Done: $out" >&2
}

# Writes to $part the video from $1 with new audio; $2 is the final path (it
# determines the codec and flags), the rest are ffmpeg options for the audio input.
# Video and subtitles are copied as is.
mux_audio() {
  local video=$1 out=$2; shift 2

  # The new track is placed at the same timestamp the old one started at,
  # so sync doesn't drift (in some files audio doesn't start at zero).
  local offset
  offset=$(ffprobe -v error -select_streams a:0 -show_entries stream=start_time -of csv=p=0 "$video")
  [[ -z "$offset" || "$offset" == N/A ]] && offset=0

  local audio_codec
  case "${out##*.}" in
    webm) audio_codec=(-c:a libopus -b:a 128k) ;;
    *)    audio_codec=(-c:a aac -b:a 192k) ;;
  esac

  local extra=()
  case "${out##*.}" in
    mp4|m4v|mov) extra=(-movflags +faststart) ;;
  esac

  ffrun "$(duration_of "$video")" \
    -i "$video" -itsoffset "$offset" "$@" \
    -map 0:v -map 1:a:0 -map 0:s? \
    -map_metadata 0 -map_chapters 0 \
    -c:v copy -c:s copy "${audio_codec[@]}" "${extra[@]}" \
    "$part"
}

# ---------------------------------------------------------------------------
# denoise

# DPDFNet models: name → native sample rate.
declare -A DENOISE_MODELS=(
  [baseline]=16000 [dpdfnet2]=16000 [dpdfnet4]=16000 [dpdfnet8]=16000
  [dpdfnet2_8khz]=8000 [dpdfnet8_8khz]=8000
  [dpdfnet2_48khz_hr]=48000 [dpdfnet8_48khz_hr]=48000
)
DENOISE_DEFAULT_MODEL=dpdfnet8_48khz_hr

usage_denoise() {
  cat >&2 <<EOF
Removes noise from speech with the DPDFNet neural network (locally, on CPU) and
puts the cleaned audio back into the video. Video is copied without re-encoding.
Audio is downmixed to mono (an empty channel is dropped, as in extract).

Usage:
  $prog denoise [options] VIDEO|AUDIO|FOLDER...

Options:
  -j, --jobs N  split the input into N overlapping segments and denoise
                them in parallel; requires at least N+1 CPU cores
                (one is left free for the rest of the system). Default 1.
  --model M       model (default $DENOISE_DEFAULT_MODEL):
                    dpdfnet8_48khz_hr, dpdfnet2_48khz_hr — full band, 48 kHz;
                    dpdfnet8 / dpdfnet4 / dpdfnet2 / baseline — 16 kHz, lose the highs;
                    dpdfnet8_8khz, dpdfnet2_8khz — telephone quality.
                  The digit is the model size: 8 is better, 2 is about 3x faster.
  --limit DB      reduce noise by at most DB dB — sounds more natural
                  (e.g. 12–20; unlimited by default)
  -o, --output P  output file (with a single input) or folder for outputs;
                  default — next to the source (video.denoised.mp4,
                  for audio — audio.denoised.wav)
  -y, --overwrite overwrite existing outputs (otherwise they are skipped)

Folders are walked recursively (video files are taken, hidden ones are skipped).
With -o, the subfolder structure is mirrored in the output folder.
EOF
  exit 1
}

cmd_denoise() {
  local model=$DENOISE_DEFAULT_MODEL limit='' jobs=1 args=()
  while (( $# )); do
    case $1 in
      --model)         model=${2:?$1 requires a value}; shift ;;
      --limit)         limit=${2:?$1 requires a value}; shift ;;
      -j|--jobs)       jobs=${2:?$1 requires a value}; shift ;;
      -o|--output)     output=${2:?$1 requires a value}; shift ;;
      -y|--overwrite)  overwrite=1 ;;
      -h|--help)       usage_denoise ;;
      --)              shift; args+=("$@"); break ;;
      -*)              die "Unknown option: $1" ;;
      *)               args+=("$1") ;;
    esac
    shift
  done
  (( ${#args[@]} )) || usage_denoise
  [[ $jobs =~ ^[0-9]+$ ]] && (( jobs >= 1 )) \
    || die "-j expects a positive number: $jobs"
  [[ -n ${DENOISE_MODELS[$model]:-} ]] \
    || die "Unknown model: $model (see $prog denoise --help)"
  [[ -z $limit || $limit =~ ^[0-9]+([.][0-9]+)?$ ]] || die "--limit expects a number of dB: $limit"
  require ffmpeg ffprobe awk
  require_denoiser

  if (( jobs > 1 )); then
    local ncpu
    ncpu=$(nproc 2>/dev/null) \
      || ncpu=$(getconf _NPROCESSORS_ONLN 2>/dev/null) \
      || ncpu=$(sysctl -n hw.ncpu 2>/dev/null) \
      || ncpu=1
    (( ncpu >= jobs + 1 )) \
      || die "Not enough CPU cores: $ncpu online, need at least $(( jobs + 1 )) for -j $jobs (one core stays free)"
  fi

  local rate=${DENOISE_MODELS[$model]}
  collect_inputs "${args[@]}"
  printf 'Model: %s (%d kHz)%s%s\n' "$model" $(( rate / 1000 )) \
    "${limit:+, at most $limit dB}" "${jobs:+, $jobs jobs}" >&2
  run_batch denoise_one
}

# Splits the audio track of $1 into $jobs overlapping segments, runs the
# denoiser on each in parallel, and writes the concatenated result to stdout
# as raw f32le mono at the model rate. $2 — audio filter applied per segment.
denoise_parallel_audio() {
  local in=$1 af=$2

  local duration total
  duration=$(duration_of "$in")
  total=$(awk -v d="$duration" -v r="$rate" 'BEGIN { printf "%d", d * r + 0.5 }')
  (( total > 0 )) || die "Zero-length audio in: $in"
  (( total / jobs >= rate )) || die "Audio is too short for $jobs jobs: $in"

  local seg_len=$(( total / jobs ))
  local overlap=$rate
  (( overlap > seg_len / 2 )) && overlap=$(( seg_len / 2 ))
  (( overlap < 1 )) && overlap=1

  local tmpdir
  tmpdir=$(mktemp -d)
  cleanup+=("$tmpdir")

  local pids=() i
  local seg_start seg_end in_start in_end extra_skip emit_count ss t
  local -a seg_durs=() progress_files=()

  for (( i = 0; i < jobs; i++ )); do
    seg_start=$(( i * seg_len ))
    if (( i == jobs - 1 )); then
      seg_end=$total
    else
      seg_end=$(( (i + 1) * seg_len ))
    fi
    in_start=$(( seg_start - overlap )); (( in_start < 0 )) && in_start=0
    in_end=$(( seg_end + overlap ));     (( in_end > total )) && in_end=$total

    extra_skip=$(( seg_start - in_start ))
    emit_count=$(( seg_end - seg_start ))

    ss=$(awk -v s="$in_start" -v r="$rate" 'BEGIN { printf "%.9f", s / r }')
    t=$(awk  -v s="$in_end" -v e="$in_start" -v r="$rate" \
                'BEGIN { printf "%.9f", (s - e) / r }')

    seg_durs+=($(( emit_count * 1000 / rate )))
    progress_files+=("$tmpdir/progress.$i")

    (
      export DJ_DENOISE_SKIP=$extra_skip DJ_DENOISE_EMIT=$emit_count
      ffmpeg -hide_banner -nostdin -nostats -loglevel error \
        -progress "$tmpdir/progress.$i" \
        -ss "$ss" -i "$in" -t "$t" -map 0:a:0 -af "$af" \
        -f f32le -ar "$rate" -ac 1 - \
        | "${denoiser[@]}" "$model" ${limit:+"$limit"} \
        > "$tmpdir/seg.$(printf '%04d' "$i").raw"
    ) &
    pids+=($!)
  done

  # По бару на задачу — только на терминале (как и в ffrun).
  local monitor_pid=''
  if [[ -t 2 ]]; then
    draw_parallel_progress "$jobs" "${seg_durs[@]}" "${progress_files[@]}" &
    monitor_pid=$!
  fi

  local rc=0 pid
  for pid in "${pids[@]}"; do
    wait "$pid" || rc=1
  done
  if [[ -n $monitor_pid ]]; then
    kill "$monitor_pid" 2>/dev/null || true
    wait "$monitor_pid" 2>/dev/null || true
  fi
  (( rc == 0 )) || die "Parallel denoise failed for: $in"

  cat "$tmpdir"/seg.*.raw
}

denoise_one() {
  local in=$1 out has_video
  has_video=$(ffprobe -v error -select_streams V -show_entries stream=index -of csv=p=0 "$in")
  if [[ -n $has_video ]]; then
    out=$(out_path "$in" ".denoised.${in##*.}")
  else
    out=$(out_path "$in" ".denoised.wav")
  fi

  local channels
  channels=$(ffprobe -v error -select_streams a:0 -show_entries stream=channels -of csv=p=0 "$in")
  [[ -z "$channels" ]] && die "No audio track in file: $in"

  begin_output "$out" "$in"
  local duration af=anull
  duration=$(duration_of "$in")
  # DPDFNet works in mono, so we downmix stereo ourselves, accounting for an empty channel.
  if [[ "$channels" == 2 ]]; then
    analyze_channels "$in" "$duration"
    af=$(mono_filter "$channel_layout")
  fi

  local raw=(-f f32le -ar "$rate" -ac 1)
  echo "Denoising..." >&2

  if (( jobs > 1 )); then
    # Parallel: split → N denoisers in parallel → cat → mux.
    if [[ -n $has_video ]]; then
      denoise_parallel_audio "$in" "$af" \
        | mux_audio "$in" "$out" "${raw[@]}" -i pipe:0
    else
      denoise_parallel_audio "$in" "$af" \
        | ffrun "$duration" "${raw[@]}" -i pipe:0 -c:a pcm_s16le "$part"
    fi
  else
    # Serial (original streaming pipeline).
    if [[ -n $has_video ]]; then
      ffmpeg -hide_banner -nostdin -loglevel error -i "$in" -map 0:a:0 -af "$af" "${raw[@]}" - \
        | "${denoiser[@]}" "$model" ${limit:+"$limit"} \
        | mux_audio "$in" "$out" "${raw[@]}" -i pipe:0
    else
      ffmpeg -hide_banner -nostdin -loglevel error -i "$in" -map 0:a:0 -af "$af" "${raw[@]}" - \
        | "${denoiser[@]}" "$model" ${limit:+"$limit"} \
        | ffrun "$duration" "${raw[@]}" -i pipe:0 -c:a pcm_s16le "$part"
    fi
  fi
  finish_output "$out"

  echo "Done: $out" >&2
}

