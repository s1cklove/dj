[[ $# -lt 1 ]] && usage
cmd=$1; shift

case "$cmd" in
  -h|--help|help) usage ;;
  -*)             echo "Unknown command: $cmd" >&2; usage ;;
esac

# The command is a full name or an unambiguous prefix of it (dj c → compress).
commands=(extract replace compress denoise)
matches=()
for c in "${commands[@]}"; do
  if [[ $c == "$cmd" ]]; then matches=("$c"); break; fi
  [[ $c == "$cmd"* ]] && matches+=("$c")
done
case ${#matches[@]} in
  0) echo "Unknown command: $cmd" >&2; usage ;;
  1) "cmd_${matches[0]}" "$@" ;;
  *) die "Ambiguous command: $cmd — ${matches[*]}" ;;
esac
